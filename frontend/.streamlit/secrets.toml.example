# Copy this file to .streamlit/secrets.toml (which is git-ignored) or set the same names as
# environment variables. Do NOT put TomTom / OpenWeather keys here — they belong in the
# BACKEND's .env file or deployment secrets. The frontend only needs the backend URL.

BACKEND_URL = "http://127.0.0.1:8000"          # production: the deployed backend URL
# REQUEST_TIMEOUT_SECONDS = 10
# HISTORICAL_CSV_PATH = "data/historical_traffic.csv"
# SEND_LOCATION_TO_BACKEND = "true"             # "false" = always use the backend's default location
